# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bibliotech

# JWT (generate secure secrets for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# SMTP (optional - for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@bibliotech.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=Bibliotech Premium <noreply@bibliotech.com>

# Firebase Cloud Messaging (optional - for push notifications)
FCM_SERVER_KEY=

# Web Push (optional)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Redis (optional - for rate limiting in production)
REDIS_URL=